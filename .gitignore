# ============================================================
# TERRA — wat nooit de repo in mag
# Aangemaakt in sessie 10 (2026-07-31), vóór de eerste commit.
# Beslissing 2 in het publicatieplan: er komt een verse repo zonder
# historie, juist omdat een sleutel die ooit gecommit is in de historie
# blijft staan. Dit bestand hoort dus als eerste te bestaan.
# ============================================================

# Sleutels. De WAQI-token leeft lokaal hier en op Vercel als environment
# variable. Nooit in de browser, nooit in de repo (beslissing 5).
.env
.env.local
.env.*.local

# Het oude sleutelbestand uit de tijd vóór /api/waqi. Staat in _backup/
# en mag onder geen beding meegecommit worden.
keys.js
relay/keys.js

# macOS
.DS_Store

# Werkmateriaal dat niet bij de code hoort
_backup/
logs/
PLAN-*.md
node_modules/

# Lokale werkomgeving. Bevat geen sleutels (gecontroleerd op 2026-08-01), maar wel
# persoonlijke permissies en paden die niemand anders iets zeggen. Draaien staat in
# de README: `node serve.mjs`. Wie met Claude Code werkt maakt zijn eigen launch.json.
.claude/

# Bouwresultaat van tools/build-standalone.mjs. Bewust NIET in de repo: het is een
# afgeleide van index.html en js/*.js, en een gegenereerd bestand in git loopt
# gegarandeerd achter op zijn bron. Het wordt verspreid als GitHub Release-asset
# onder exact deze naam; de README linkt naar /releases/latest/download/terra.html.
#
# LET OP: een .gitignore-regel werkt alleen op bestanden die git nog NIET volgt.
# Op 2026-08-01 raakten beide builds alsnog gecommit omdat ze al in de werkboom
# stonden toen de commit liep. Staat er ooit toch iets in: `git rm --cached`.
terra.html
terra-standalone.html


# Werknotitie, geen onderdeel van het project
docs/README-screenshot.txt

# Het tuning-paneel (sessie 40). Een ontwikkelinstrument: het staat achter
# IS_LOCAL, wordt met een DYNAMISCHE import() geladen en hoort niet in de repo
# of in de standalone.
#
# Die dynamische vorm is niet toevallig. tools/build-standalone.mjs leidt af
# welke modules hij insluit uit regels die met `import ... from` BEGINNEN; een
# `await import(...)` matcht die regex niet en valt er dus vanzelf buiten. Er is
# daarom geen uitzondering in de build nodig — hij volgt uit de vorm.
#
# De aanroep in index.html heeft een stille .catch(): wie de repo kloont heeft
# dit bestand niet, en dan gebeurt er niets. Er blijft wel een 404 in het
# netwerktabblad staan — je kunt niet weten of een bestand bestaat zonder het op
# te vragen — maar de JS-console blijft schoon.
js/ui/tuning-panel.js
_v1-referentie/
